<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:text="CHỈNH SỬA HỒ SƠ (BÀI TẬP 16)"
            android:textColor="#34B469"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#243342"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvStudentId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Nhập Họ tên mới -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Họ và tên:"
                    android:textColor="#FFFFFF" />

                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập họ tên"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080" />

                <!-- Nhập GPA mới -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Điểm GPA:"
                    android:textColor="#FFFFFF" />

                <EditText
                    android:id="@+id/edtGpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập GPA (0.0 - 4.0)"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#808080" />

                <!-- Nút Đóng / Quay lại -->
                <Button
                    android:id="@+id/btnClose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#4E5D6C"
                    android:text="Đóng màn hình"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hiển thị dữ liệu nhận được từ Intent -->
        <TextView
            android:id="@+id/tvReceivedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:textColor="#E0E0E0"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>